# Copy to `.env` in the project root. Expo SDK 49 inlines EXPO_PUBLIC_* into
# the JS bundle. Do not put API secrets in client env vars.

# Backend base URL. Read by app/config/config.dev.ts and config.prod.ts,
# then used as Config.API_URL in app/services/api/api.ts.
# Auth and most screens still use in-app dummy data; this URL is for a
# future API client.
EXPO_PUBLIC_API_URL=https://api.example.com/

# --- Keys in app/config (not process.env) ---
# persistNavigation  app/config/config.base.ts  ("always" | "dev" | "prod" | "never")
#                    read by app/navigators/navigationUtilities.ts
# catchErrors        app/config/config.base.ts  ("always" | "dev" | "prod" | "never")
#                    read by app/app.tsx ErrorBoundary
# exitRoutes         app/config/config.base.ts  Android back-button exit screens
#                    read by app/navigators/AppNavigator.tsx

# --- Native / tooling (not JS Config) ---
# EX_UPDATES_NATIVE_DEBUG=1
#   Optional. Read by android/app/build.gradle via System.getenv.

# NODE_BINARY
#   iOS Xcode script path. Set in ios/.xcode.env (versioned) or
#   ios/.xcode.env.local (gitignored).

# --- Stubs, not read at runtime ---
# crashReporting.ts has commented Sentry / Bugsnag init. These are not
# wired. If you enable them, keep the DSN / API key out of git.
# SENTRY_DSN=
# BUGSNAG_API_KEY=
